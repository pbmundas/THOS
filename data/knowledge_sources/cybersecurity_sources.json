{
  "schema_version": 1,
  "policy": {
    "description": "Only primary, community-reviewed, or explicitly licensed internal material may enter the THOS cybersecurity corpus.",
    "allowed_trust_tiers": ["primary", "community-reviewed", "internal-licensed"],
    "prohibited": ["unknown-license", "proprietary-unlicensed", "synthetic-unverified"],
    "default_refresh_days": 30
  },
  "sources": [
    {
      "id": "mitre_attack_enterprise",
      "title": "MITRE ATT&CK Enterprise STIX 2.1",
      "enabled": true,
      "required": true,
      "kind": "json",
      "location": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json",
      "publisher": "MITRE",
      "license": "MITRE ATT&CK Terms of Use",
      "license_url": "https://attack.mitre.org/resources/terms-of-use/",
      "trust_tier": "primary",
      "domains": ["threat_hunting", "threat_detection", "red_teaming", "purple_teaming", "detection_engineering"],
      "refresh_days": 30,
      "max_bytes": 80000000
    },
    {
      "id": "cisa_kev",
      "title": "CISA Known Exploited Vulnerabilities Catalog",
      "enabled": true,
      "required": true,
      "kind": "json",
      "location": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json",
      "publisher": "CISA",
      "license": "U.S. Government Work / CISA Terms",
      "license_url": "https://www.cisa.gov/about/website-policies",
      "trust_tier": "primary",
      "domains": ["advisories", "incident_response", "threat_detection"],
      "refresh_days": 1,
      "max_bytes": 20000000
    },
    {
      "id": "nist_csf_2",
      "title": "NIST Cybersecurity Framework 2.0",
      "enabled": true,
      "required": true,
      "kind": "pdf",
      "location": "https://nvlpubs.nist.gov/nistpubs/CSWP/NIST.CSWP.29.pdf",
      "publisher": "NIST",
      "license": "U.S. Government Work",
      "license_url": "https://www.nist.gov/open/license",
      "trust_tier": "primary",
      "domains": ["frameworks", "incident_response", "governance"],
      "refresh_days": 365,
      "max_bytes": 25000000
    },
    {
      "id": "nist_sp_800_61r3",
      "title": "NIST SP 800-61 Rev. 3 Incident Response",
      "enabled": true,
      "required": true,
      "kind": "pdf",
      "location": "https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-61r3.pdf",
      "publisher": "NIST",
      "license": "U.S. Government Work",
      "license_url": "https://www.nist.gov/open/license",
      "trust_tier": "primary",
      "domains": ["incident_response", "frameworks"],
      "refresh_days": 365,
      "max_bytes": 25000000
    },
    {
      "id": "nist_sp_800_115",
      "title": "NIST SP 800-115 Security Testing and Assessment",
      "enabled": true,
      "required": false,
      "kind": "pdf",
      "location": "https://nvlpubs.nist.gov/nistpubs/Legacy/SP/nistspecialpublication800-115.pdf",
      "publisher": "NIST",
      "license": "U.S. Government Work",
      "license_url": "https://www.nist.gov/open/license",
      "trust_tier": "primary",
      "domains": ["red_teaming", "purple_teaming", "frameworks"],
      "refresh_days": 365,
      "max_bytes": 25000000
    },
    {
      "id": "nist_sp_800_92",
      "title": "NIST SP 800-92 Computer Security Log Management",
      "enabled": true,
      "required": false,
      "kind": "pdf",
      "location": "https://nvlpubs.nist.gov/nistpubs/Legacy/SP/nistspecialpublication800-92.pdf",
      "publisher": "NIST",
      "license": "U.S. Government Work",
      "license_url": "https://www.nist.gov/open/license",
      "trust_tier": "primary",
      "domains": ["log_analysis", "log_investigation", "frameworks"],
      "refresh_days": 365,
      "max_bytes": 25000000
    },
    {
      "id": "sigmahq_rules",
      "title": "Pinned SigmaHQ Detection Rules",
      "enabled": true,
      "required": true,
      "kind": "local_glob",
      "location": "/repo/services/detection/sigma_rules_hq/**/*.yml",
      "fallback_location": "services/detection/sigma_rules_hq/**/*.yml",
      "publisher": "SigmaHQ",
      "license": "Detection Rule License 1.1",
      "license_url": "https://github.com/SigmaHQ/Detection-Rule-License",
      "trust_tier": "community-reviewed",
        "domains": ["detection_engineering", "threat_detection", "threat_hunting", "purple_teaming", "log_analysis"],
      "refresh_days": 30,
      "max_files": 5000
    },
    {
      "id": "organization_licensed_material",
      "title": "Organization-Licensed Advanced Training Material",
      "enabled": false,
      "required": false,
      "kind": "local_glob",
      "location": "/data/licensed_cyber_training/**/*",
      "publisher": "Configured by organization",
      "license": "PROPRIETARY-LICENSE-REQUIRED",
      "license_url": "",
      "trust_tier": "internal-licensed",
      "domains": ["red_teaming", "threat_hunting", "incident_response", "threat_detection", "detection_engineering", "purple_teaming", "advisories", "frameworks", "log_analysis", "log_investigation"],
      "refresh_days": 0,
      "max_files": 10000,
      "enablement_requirement": "Set enabled=true only after legal approval and mount licensed files read-only at the configured path."
    }
  ]
}
