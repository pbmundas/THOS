# Copy this file to .env and adjust before running `docker compose up`

# --- Auth (chat-ui, orchestrator API, MCP server) ---
# THOS fails closed when these secrets are missing or use a known placeholder.
# Generate unique values before the first `docker compose up`, e.g.:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=
ORCHESTRATOR_API_KEY=
# Single hunter login (used only if CHATUI_USERS below is left blank):
CHATUI_USERNAME=
CHATUI_PASSWORD=
# For more than one hunter, set CHATUI_USERS instead — comma-separated
# user:pass pairs, e.g.:
# CHATUI_USERS=hunter:<strong-password>,bob:<strong-password>
# When set, this takes precedence over CHATUI_USERNAME/CHATUI_PASSWORD.
CHATUI_USERS=
# Redis had no auth at all before — now requires this password.
CHATUI_SESSION_SECRET=
REDIS_PASSWORD=

# --- Ollama ---
OLLAMA_MODEL=qwen3:4b
# Larger reasoning quality: qwen3:4b (needs more RAM/VRAM)

# --- Community detection-rule catalog ---
# Compose first uses reviewed YAML files committed under
# services/detection/sigma_rules_hq/. If those are absent, its one-shot
# initializer downloads this exact pinned community-rules commit into a persistent
# volume before MCP is allowed to start. Keep this a commit hash, not master.
SIGMAHQ_REF=282369fa76c5cd6103b055478fbaebec8530cfa5
# Fail startup instead of silently evaluating only the 16 local THOS rules.
SIGMAHQ_MIN_RULES=2000

# --- Agentic model fleet (all endpoints must be on-prem) ---
# Unset values safely inherit OLLAMA_HOST + OLLAMA_MODEL above. Set a model
# and optional host per tier to route specialist agents to separate Ollama or
# vLLM instances. Suggested names are comments, not automatic downloads.
# Ask THOS, communication, and lightweight extraction use this low-latency tier.
THOS_MODEL_FAST=qwen2.5-coder:1.5b-instruct
THOS_MODEL_GUARD=qwen2.5-coder:1.5b-instruct
# THOS_MODEL_REASONING=qwen3:32b
# THOS_MODEL_VERIFIER=deepseek-r1:32b
# THOS_MODEL_CODING=qwen3-coder:30b
# THOS_MODEL_GUARD=phi4-mini
# THOS_OLLAMA_FAST_HOST=http://ollama:11434
# THOS_OLLAMA_REASONING_HOST=http://ollama:11434
# THOS_OLLAMA_VERIFIER_HOST=http://ollama:11434
# THOS_OLLAMA_CODING_HOST=http://ollama:11434
# THOS_OLLAMA_GUARD_HOST=http://ollama:11434

# --- Postgres (audit trail / hunt state) ---
POSTGRES_USER=thos
POSTGRES_PASSWORD=
POSTGRES_DB=thos_audit

# --- SIEM credentials (Phase 2 — leave blank for Phase 1 mock mode) ---
SIEM_TYPE=folder
ALLOW_SYNTHETIC_TELEMETRY=0
# SIEM_TYPE=wazuh | elasticsearch | logrhythm | splunk | qradar | folder
# ELASTICSEARCH_URL=https://elasticsearch.example.com:9200
# ELASTICSEARCH_INDEX_PATTERN=logs-*
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_VERIFY_SSL=1
# ELASTICSEARCH_LOOKBACK_MINUTES=1440
# "folder": hunt against a local directory of log files instead of a
# live SIEM API. Known formats (.evtx .log .syslog .csv .cef .json .ecs
# .ndjson .jsonl .xml .txt .pcap .pcapng) are parsed into records. Every
# other regular file receives bounded magic/metadata/string triage instead
# of being silently ignored.
# The folder itself is chosen per-hunt from the chat UI ("Log folder
# path"), but LOG_SOURCE_DIR sets the default / where uploads land.
LOG_SOURCE_DIR=/data/log_sources
# Any folder path passed in for "folder" mode must resolve inside one of
# these roots (os.pathsep-separated for multiple), or the request is
# rejected — without this, log_source_path accepted any container-
# readable path with no auth in front of it. Defaults to LOG_SOURCE_DIR
# if unset.
# LOG_SOURCE_ALLOWED_ROOTS=/data/log_sources

# --- Digital forensics ---
# Originals are preserved below /data/log_sources/forensic/<UTC date>/.
FORENSIC_MAX_FILE_BYTES=21474836480
FORENSIC_MAX_CASE_BYTES=107374182400
FORENSIC_MAX_RECORDS=50000
FORENSIC_MAX_DOCUMENT_TEXT=2097152
# Per-tool static-analysis resource boundaries. Files larger than the static
# limit remain hashed/inventoried and can still use large-file YARA profiles.
FORENSIC_TOOL_TIMEOUT_SECONDS=180
FORENSIC_TOOL_OUTPUT_BYTES=200000
FORENSIC_MAX_STATIC_FILE_BYTES=2147483648
FORENSIC_STRINGS_MIN_LENGTH=6
# Signature validation is bursty; 256 MiB is insufficient for current daily DBs.
CLAMAV_UPDATE_CPU_LIMIT=0.25
CLAMAV_UPDATE_MEM_LIMIT=1g
CLAMAV_UPDATE_INTERVAL_SECONDS=3600
YARA_MEMORY_MAX_FILE_BYTES=21474836480
YARA_MEMORY_SCAN_TIMEOUT_SECONDS=600

# Wazuh Indexer / OpenSearch API (security-event search, normally port 9200).
# Docker Desktop exposes the host to containers as host.docker.internal.
# Use a dedicated read-only Indexer account outside this local lab.
WAZUH_INDEXER_URL=https://host.docker.internal:9200
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
# The purple-team lab uses self-signed certificates. Set this to 0 only for
# that isolated lab, or mount its root-ca.pem and set WAZUH_CA_BUNDLE.
WAZUH_VERIFY_SSL=1
WAZUH_CA_BUNDLE=
# alerts = wazuh-alerts-*; archives = wazuh-archives-*; both = both patterns.
WAZUH_INDEX_SOURCE=both
WAZUH_LOOKBACK_MINUTES=1440
WAZUH_REQUEST_TIMEOUT_SECONDS=30
WAZUH_MAX_RESULTS=1000
# Bound exact hit counting per scheduled rule. The engine retains a bounded
# evidence sample and does not need an unbounded exact count.
WAZUH_MSEARCH_TRACK_TOTAL_HITS=1000
# Batch scheduling owns adaptive backpressure. Connector-level replay is off
# so one expensive request cannot be repeated while the Indexer is restarting.
WAZUH_MSEARCH_RETRIES=0
# Live Indexer safeguards: serialize at the soft threshold and defer the batch
# at the hard heap/queue threshold without issuing another search.
THOS_WAZUH_HEAP_SOFT_LIMIT_PERCENT=60
THOS_WAZUH_HEAP_HARD_LIMIT_PERCENT=80
THOS_WAZUH_SEARCH_QUEUE_LIMIT=50
# Generic utility, cryptographic-pattern, and deprecated file signatures stay
# cataloged and individually opt-in, but are excluded from the default
# actionable compiled bundle to prevent ordinary evidence matching as malware.
YARA_DEFAULT_EXCLUDED_CATEGORIES=utils,crypto,deprecated
# The governed hypothesis corpus refreshes during startup and can be refreshed
# explicitly. Keep outbound refresh outside hunt latency unless deliberately
# enabled; failed attempts are suppressed for the shorter TTL.
HEARTH_REFRESH_DURING_HUNT=0
HEARTH_REFRESH_FAILURE_TTL_SECONDS=900

LOGRHYTHM_BASE_URL=
LOGRHYTHM_API_TOKEN=
# Optional tuning (defaults shown) — see services/siem/logrhythm.py
# LOGRHYTHM_VERIFY_SSL=1
# LOGRHYTHM_LOOKBACK_MINUTES=1440
# LOGRHYTHM_POLL_INTERVAL_SECONDS=2
# LOGRHYTHM_POLL_TIMEOUT_SECONDS=60
# LOGRHYTHM_SEARCH_EVENTS=0

SPLUNK_BASE_URL=
SPLUNK_TOKEN=
# Optional tuning (defaults shown) — see services/siem/splunk.py
# SPLUNK_VERIFY_SSL=1
# SPLUNK_LOOKBACK=-24h
# SPLUNK_POLL_INTERVAL_SECONDS=2
# SPLUNK_POLL_TIMEOUT_SECONDS=60

QRADAR_BASE_URL=
QRADAR_TOKEN=
# Optional tuning (defaults shown) — see services/siem/qradar.py
# QRADAR_VERIFY_SSL=1
# QRADAR_API_VERSION=20.0
# QRADAR_LOOKBACK_MINUTES=1440
# QRADAR_POLL_INTERVAL_SECONDS=2
# QRADAR_POLL_TIMEOUT_SECONDS=60

# --- Logging ---
# Structured JSON logs on stdout for mcp/orchestrator/chat-ui — one of
# DEBUG/INFO/WARNING/ERROR. See services/observability/logging_config.py.
LOG_LEVEL=INFO
# At most one targeted SIEM re-query after initial reasoning. This prevents
# long repeated full-pipeline loops while retaining adaptive evidence fetch.
MAX_REASONING_FOLLOWUPS=1
# Per local-model call bound. Final reasoning is retried up to three total
# attempts; after the third failure the hunt records why and writes no report.
OLLAMA_GENERATION_TIMEOUT_SECONDS=180
# Query and indicator calls are structured fast-tier work; fall back to
# deterministic logic after this bound, preserving the reasoning budget.
THOS_FAST_GENERATION_TIMEOUT_SECONDS=60
# Transport retry budget for non-reasoning model calls. The final reasoning node
# disables nested transport retries and applies its exact three-strike rule.
OLLAMA_GENERATION_RETRIES=3

# --- Schema-aware scheduled detections ---
# A bounded sample of each active live SIEM is inventoried weekly. Snapshots
# remain cached longer than one interval so a missed refresh never blocks hunts.
SIEM_SCHEMA_REFRESH_INTERVAL_HOURS=168
SIEM_SCHEMA_REFRESH_RETRY_HOURS=6
SIEM_SCHEMA_REFRESH_SECONDS=604800
SIEM_SCHEMA_RETENTION_SECONDS=3024000
# 0 compiles the full vendored corpus. Set a positive cap only on constrained
# development machines; production should keep complete scheduled coverage.
SIGMA_WEEKLY_MAX_RULES=0
# Suppress the same event returned by consecutive scheduled runs while retaining
# a detail hash and time bucket so distinct events are not collapsed.
SIGMA_DEDUP_WINDOW_SECONDS=3600
# Number of schema-compatible rules selected per scheduled rotation. Wazuh
# executes this batch as one multi-search request and halves it only if the
# indexer signals transport pressure.
THOS_SIGMA_RULES_PER_BATCH=8
THOS_WAZUH_MSEARCH_BATCH_SIZE=8
# Bound returned evidence per rule so a broad rule cannot exhaust the indexer.
THOS_WAZUH_MSEARCH_RULE_LIMIT=10

# --- Governed cybersecurity knowledge ---
# Primary/open sources are declared with publisher, license, trust tier, and
# refresh cadence in data/knowledge_sources/cybersecurity_sources.json.
CYBER_CORPUS_ENABLED=1
# Set to 1 only when a failed required source should fail kb-ingest startup.
# Keep 0 for air-gapped deployments that use the last persisted Chroma corpus.
CYBER_CORPUS_REQUIRED=0
# Optional comma-separated source IDs for a controlled partial refresh.
CYBER_CORPUS_SOURCE_IDS=
# Retrieval rejects distant results with no lexical overlap. Tune only against
# the cybersecurity retrieval eval set; a larger value increases recall and
# hallucination risk.
CYBER_KB_MAX_DISTANCE=1.35

# --- Analyst UI session ---
# Local timezone used by hypothesis and detection-rule schedules. The Settings page
# displays this value and all schedule times are evaluated against it.
TZ=Asia/Kolkata
# The React login form exchanges credentials with the local gateway, which
# returns an HTTP-only, SameSite=Strict signed session cookie. Set a long random
# secret. Use CHATUI_SECURE_COOKIE=1 when localhost is placed behind HTTPS.
CHATUI_SESSION_SECRET=replace_with_a_long_random_session_secret
CHATUI_SESSION_TTL_SECONDS=43200
CHATUI_SECURE_COOKIE=0
# The first configured account is seeded as the SME administrator. Additional
# SME and Analyst users are created from Settings > Users & roles.
# CHATUI_USER=analyst
# CHATUI_PASSWORD=<generate-a-unique-password>
# Maximum bytes accepted from one configured IOC source (100 MiB).
THOS_IOC_MAX_SOURCE_BYTES=104857600
# Keep disabled unless an explicitly trusted internal intelligence server is required.
THOS_IOC_ALLOW_PRIVATE_FETCH=0
